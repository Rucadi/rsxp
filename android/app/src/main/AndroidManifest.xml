<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="RSXP Engine" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:hasCode="true">
        <activity android:name=".GameFolderActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name="android.app.NativeActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="rsxp"/>
        </activity>
    </application>
</manifest>
