{
  "openapi": "3.1.0",
  "info": {
    "title": "rsxp Live Game API",
    "description": "Loopback API whose game and input routes are supplied by loaded Rhai plugins. Discover the active route catalog through /v1/extensions/routes.",
    "license": {
      "name": "GPL-2.0-or-later",
      "identifier": "GPL-2.0-or-later"
    },
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:47821",
      "description": "Running local game process"
    }
  ],
  "paths": {
    "/v1/extensions/routes": {
      "get": {
        "tags": [
          "Extensions"
        ],
        "operationId": "listExtensionRoutes",
        "responses": {
          "200": {
            "description": "Routes exposed by the currently loaded Rhai plugins",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionRouteCatalog"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtensionRoute": {
        "type": "object",
        "required": [
          "method",
          "path",
          "operation",
          "arguments"
        ],
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "ExtensionRouteCatalog": {
        "type": "object",
        "required": [
          "routes"
        ],
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionRoute"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Extensions"
    }
  ]
}
