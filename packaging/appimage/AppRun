#!/bin/sh
# AppImage entry point: expose the bundled libraries and Ruby, then run rsxp.
#
# The executable itself relocates Ruby through the ruby-runtime.json manifest
# beside it (see src/desktop/bundled_runtime.rs); LD_LIBRARY_PATH covers the
# native library closure staged in usr/lib.
set -e

here="$(dirname "$(readlink -f "$0")")"
export PATH="$here/usr/bin:$PATH"
export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$here/usr/bin/rsxp" "$@"
